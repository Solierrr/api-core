meta {
  name: [mutates] PUT /api/users/{id}
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/api/users/{{id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "authId": "{{sampleUuid}}",
    "username": "local_user"
  }
}

